# Example project config. Copy to projects/<name>.env (that file is gitignored)
# and pass --project <name>. Sourced by run-issue.sh, so plain shell syntax.

# Local clone of the repo the agents will work on, and its GitHub slug.
REPO_PATH="/path/to/your/repo"
REPO_SLUG="your-org/your-repo"
DEFAULT_BRANCH="main"

# Directory where per-issue git worktrees are created.
WORKTREE_BASE="/path/to/worktrees"

# Session logs, state files and sessions.jsonl are written here; STATUS_FILE is
# an optional running notes file the agent is told to keep up to date.
LOG_DIR="/path/to/agent-loop-logs"
STATUS_FILE="/path/to/agent-loop-logs/STATUS.md"

# Optional file of extra standing rules appended to every session's prompt.
STANDING_RULES_FILE=""
